{
  "name": "argvio-node",
  "private": true,
  "description": "Node.js SDKs for emitting CLI usage telemetry to Argvio's ingest server",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getargvio/argvio-node.git"
  },
  "homepage": "https://github.com/getargvio/argvio-node",
  "bugs": {
    "url": "https://github.com/getargvio/argvio-node/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "pretypecheck": "pnpm --filter @getargvio/argvio run build",
    "pretest": "pnpm --filter @getargvio/argvio run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "prettier": "^3",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
